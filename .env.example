# URL dasar n8n, tanpa garis miring di akhir.
N8N_URL=http://localhost:5678

# API key n8n: Settings -> n8n API -> Create an API key.
# Jangan pernah menaruh nilai ini di kode frontend atau commit ke Git.
N8N_API_KEY=

# API key OpenRouter untuk penjelasan log AI (opsional, kosong = fitur 503).
OPENROUTER_API_KEY=

# Akun n8n (email + password login UI) untuk fitur "Jalankan workflow".
# Kosongkan = tombol Jalankan membalas 503.
N8N_EMAIL=
# Nilai yang mengandung karakter # wajib diapit tanda kutip:
# N8N_PASSWORD="kata#sandi"
N8N_PASSWORD=

# Kredensial Basic Auth untuk seluruh dashboard.
DASH_USER=admin
DASH_PASS=

# Port server dashboard.
PORT=3000
